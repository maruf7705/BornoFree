#!/usr/bin/env bash
# Switch the active Fcitx5 input method for BornoFree's Hyprland bindings.
set -euo pipefail

readonly BORNO_IM="${BORNOFREE_BENGALI_IM:-borno}"
readonly PHONETIC_IM="${BORNOFREE_PHONETIC_IM:-borno-phonetic}"
readonly ENGLISH_IM="${BORNOFREE_ENGLISH_IM:-keyboard-us}"
readonly REMOTE="${FCITX5_REMOTE:-fcitx5-remote}"

usage() {
    cat <<'EOF'
Usage: borno-fcitxctl {toggle|bangla|phonetic|english|status}

Environment overrides:
  BORNOFREE_BENGALI_IM    Fcitx Unicode input method name (default: borno)
  BORNOFREE_PHONETIC_IM   Fcitx Phonetic input method name (default: borno-phonetic)
  BORNOFREE_ENGLISH_IM    Fcitx English method name (default: keyboard-us)
EOF
}

ensure_fcitx() {
    if "$REMOTE" -n >/dev/null 2>&1; then
        return
    fi
    command -v fcitx5 >/dev/null 2>&1 || {
        echo "BornoFree: fcitx5 is not installed." >&2
        exit 1
    }
    fcitx5 -d
    for _ in $(seq 1 20); do
        if "$REMOTE" -n >/dev/null 2>&1; then
            return
        fi
        sleep 0.1
    done
    echo "BornoFree: Fcitx5 did not start on the current session bus." >&2
    exit 1
}

current_im() {
    "$REMOTE" -n 2>/dev/null | tr -d '\r\n'
}

set_im() {
    "$REMOTE" -s "$1"
    sleep 0.05
}

command_name="${1:-}"
case "$command_name" in
    toggle|bangla|phonetic|english|status) ;;
    -h|--help|help|'') usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

ensure_fcitx
current="$(current_im)"

case "$command_name" in
    toggle)
        if [[ "$current" == "$BORNO_IM" || "$current" == "$PHONETIC_IM" ]]; then
            set_im "$ENGLISH_IM"
        else
            set_im "$BORNO_IM"
        fi
        ;;
    bangla) set_im "$BORNO_IM" ;;
    phonetic) set_im "$PHONETIC_IM" ;;
    english) set_im "$ENGLISH_IM" ;;
    status)
        if [[ "$current" == "$BORNO_IM" ]]; then
            printf 'অ\n'
        elif [[ "$current" == "$PHONETIC_IM" ]]; then
            printf 'ফো\n'
        else
            printf 'EN\n'
        fi
        exit 0
        ;;
esac

current="$(current_im)"
if [[ "$current" == "$BORNO_IM" ]]; then
    printf 'অ\n'
elif [[ "$current" == "$PHONETIC_IM" ]]; then
    printf 'ফো\n'
else
    printf 'EN\n'
fi
